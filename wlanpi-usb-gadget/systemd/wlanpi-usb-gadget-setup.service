[Unit]
Description=WLAN Pi USB Gadget Setup
DefaultDependencies=no
After=local-fs.target sys-kernel-config.mount systemd-modules-load.service
Before=systemd-networkd.service network-pre.target
Wants=network-pre.target
RequiresMountsFor=/var/lib/wlanpi-usb-gadget

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/wlanpi-usb-gadget apply
ExecStop=/usr/bin/wlanpi-usb-gadget teardown
RuntimeDirectory=wlanpi-usb-gadget
RuntimeDirectoryPreserve=yes
StateDirectory=wlanpi-usb-gadget
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/sys/kernel/config -/sys/class/udc -/run/wlanpi-usb-gadget /run/systemd -/var/lib/wlanpi-usb-gadget

[Install]
WantedBy=sysinit.target
